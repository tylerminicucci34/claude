# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: voice input (Whisper). Skip for text-only mode. ---
OPENAI_API_KEY=

# --- Tunables ---
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=1024
WHISPER_MODEL=whisper-1

# How Jarvis addresses you
JARVIS_USER_NAME=Tyler
JARVIS_USER_ADDRESS=Sir

# Audio
JARVIS_SAMPLE_RATE=16000
JARVIS_SILENCE_THRESHOLD=0.02
JARVIS_SILENCE_DURATION=1.2

# Screen capture
JARVIS_CAPTURE_SCREEN=true
JARVIS_SCREEN_MAX_DIM=1568

# Piper voice model (downloaded via: python -m jarvis.download_voice)
# default is the British male "Alan" voice — leave unset to use it
# PIPER_VOICE_MODEL=/absolute/path/to/voices/en_GB-alan-medium.onnx
