# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional but recommended ---
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=

# --- Tunables ---
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MAX_TOKENS=1024
WHISPER_MODEL=whisper-1
ELEVENLABS_MODEL=eleven_turbo_v2_5

# How Jarvis addresses you
JARVIS_USER_NAME=Tyler
JARVIS_USER_ADDRESS=Sir

# Audio
JARVIS_SAMPLE_RATE=16000
JARVIS_SILENCE_THRESHOLD=0.02
JARVIS_SILENCE_DURATION=1.2

# Screen capture
JARVIS_CAPTURE_SCREEN=true
JARVIS_SCREEN_MAX_DIM=1568
